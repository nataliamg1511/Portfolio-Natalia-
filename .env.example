# Supabase — veja CLAUDE.md para o passo a passo de como criar o projeto,
# rodar as migrations e preencher estas variáveis. Enquanto estiverem
# vazias, o site inteiro funciona com o conteúdo seed local (lib/data/seed.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada em metadata, sitemap.xml e robots.txt).
NEXT_PUBLIC_SITE_URL=https://nataliamachado.com.br
